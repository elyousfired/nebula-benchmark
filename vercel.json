{
    "regions":  [
                    "fra1"
                ],
    "headers":  [
                    {
                        "source":  "/index.html",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-cache"
                                        }
                                    ]
                    }
                ],
    "rewrites":  [
                     {
                         "destination":  "/index.html",
                         "source":  "/squeeze"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/agent"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/top5"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/combo"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/stable"
                     }
                 ],
    "functions":  {
                      "api/squeeze.js":  {
                                             "maxDuration":  30
                                         },
                      "api/stable.js":  {
                                            "maxDuration":  30
                                        }
                  }
}