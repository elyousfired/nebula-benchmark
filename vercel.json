{
    "regions":  [
                    "fra1"
                ],
    "headers":  [
                    {
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-cache"
                                        }
                                    ],
                        "source":  "/((?!assets/|api/).*)"
                    }
                ],
    "rewrites":  [
                     {
                         "destination":  "/index.html",
                         "source":  "/squeeze"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/agent"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/top5"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/combo"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/stable"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/btc"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/system"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/forecast"
                     }
                 ],
    "functions":  {
                      "api/squeeze.js":  {
                                             "maxDuration":  30
                                         },
                      "api/stable.js":  {
                                            "maxDuration":  30
                                        },
                      "api/followers.js":  {
                                               "maxDuration":  30
                                           }
                  }
}